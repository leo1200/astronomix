# AthenaPK reference leg of the Cas A two-phase cross-validation (tier 1).
# Matches examples/gallery/supernova_showcase/casa_turb_phase.py at 128^3:
# uniform n = 5 cm^-3 (rho = 5 * 1.4 m_p), P = n k_B 1e4 K, box 7 pc,
# solenoidal OU driving to v_rms ~ 15 km/s, Schure cooling (1.0 Z).
# Code units: pc / Msun / Myr (code velocity = 0.978 km/s).
# Known physics deltas vs the astronomix leg (accepted for tier 1, see
# README): cooling-floor band (astronomix gates < 1e4 K, this table ends at
# log T = 4.2), forcing implementation (few-mode OU vs full-spectrum white),
# PPM+HLLC+FOFC vs WENO+preserving_flux.

<comment>
problem = Cas A two-phase pipeline, phase A reference (driven turbulent box)

<job>
problem_id = turbulence

<parthenon/output1>
file_type  = hst
dt         = 0.005

<parthenon/output2>
file_type  = hdf5
variables  = prim
dt         = 0.0575    # 8 dumps over 2 turnovers
id         = prim
single_precision_output = true

<parthenon/time>
cfl        = 0.3
nlim       = 400000
tlim       = 0.46      # 2 turnovers of the k=2 scale at 15.3 code
integrator = rk3
ncycle_out_mesh = -500

<parthenon/mesh>
nghost     = 3
nx1        = 128
x1min      = 0.0
x1max      = 7.0
ix1_bc     = periodic
ox1_bc     = periodic

nx2        = 128
x2min      = 0.0
x2max      = 7.0
ix2_bc     = periodic
ox2_bc     = periodic

nx3        = 128
x3min      = 0.0
x3max      = 7.0
ix3_bc     = periodic
ox3_bc     = periodic

packs_per_rank = 1

<parthenon/meshblock>
nx1        = 64
nx2        = 64
nx3        = 64

<hydro>
fluid = euler
eos = adiabatic
riemann = hllc
reconstruction = ppm
gamma = 1.666666666666667
Tfloor = 10                # tiny; the cooling table edge governs the cutoff
He_mass_fraction = 0.28
first_order_flux_correct = true

<cooling>
enable_cooling = tabular
table_filename = schure.cooling_1.0Z
lambda_units_cgs = 1
integrator = rk12
max_iter = 100
cfl = 0.10
d_log_temp_tol = 1e-8
d_e_tol = 1e-5

<units>
code_length_cgs = 3.085677580962325e+18  # 1 pc
code_mass_cgs = 1.98841586e+33           # 1 Msun
code_time_cgs = 3.15576e+13              # 1 Myr

<problem/turbulence>
rho0         = 172.9    # 5 cm^-3 * 1.4 m_p in Msun/pc^3
p0           = 10.66    # 5 cm^-3 * k_B 1e4 K in code pressure
corr_time    = 0.23     # ~ one k=2 eddy turnover
rseed        = 7
kpeak        = 2.0
sol_weight   = 1.0
accel_rms    = 67.0     # ~ v_rms^2 / L_f; tune to land v_rms ~ 15 km/s
num_modes    = 30

<modes>
k_1_0	= +2
k_1_1	= -1
k_1_2	= +0
k_2_0	= +1
k_2_1	= +0
k_2_2	= +2
k_3_0	= +1
k_3_1	= +1
k_3_2	= -1
k_4_0	= +2
k_4_1	= +0
k_4_2	= +1
k_5_0	= +0
k_5_1	= +0
k_5_2	= -1
k_6_0	= +1
k_6_1	= -1
k_6_2	= -2
k_7_0	= +0
k_7_1	= +0
k_7_2	= -2
k_8_0	= +1
k_8_1	= +0
k_8_2	= -1
k_9_0	= +0
k_9_1	= +2
k_9_2	= +1
k_10_0	= +0
k_10_1	= -1
k_10_2	= +2
k_11_0	= +0
k_11_1	= +0
k_11_2	= +2
k_12_0	= +0
k_12_1	= +2
k_12_2	= -1
k_13_0	= +2
k_13_1	= +1
k_13_2	= +1
k_14_0	= +1
k_14_1	= -1
k_14_2	= +0
k_15_0	= +0
k_15_1	= -1
k_15_2	= -1
k_16_0	= +1
k_16_1	= +0
k_16_2	= +1
k_17_0	= +0
k_17_1	= -1
k_17_2	= +1
k_18_0	= +0
k_18_1	= +1
k_18_2	= +0
k_19_0	= +1
k_19_1	= -1
k_19_2	= +1
k_20_0	= +2
k_20_1	= +1
k_20_2	= -1
k_21_0	= +0
k_21_1	= -1
k_21_2	= -2
k_22_0	= +2
k_22_1	= -1
k_22_2	= +1
k_23_0	= +0
k_23_1	= +1
k_23_2	= +1
k_24_0	= +1
k_24_1	= -2
k_24_2	= +1
k_25_0	= +1
k_25_1	= -2
k_25_2	= +0
k_26_0	= +1
k_26_1	= +2
k_26_2	= +0
k_27_0	= +1
k_27_1	= -2
k_27_2	= -1
k_28_0	= +2
k_28_1	= -1
k_28_2	= -1
k_29_0	= +1
k_29_1	= +2
k_29_2	= -1
k_30_0	= +1
k_30_1	= +1
k_30_2	= +2

